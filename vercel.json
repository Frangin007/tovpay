{
  "redirects": [
    { "source": "/nano-credit", "destination": "/avance-sur-salaire", "permanent": true },
    { "source": "/services", "destination": "/avance-sur-salaire", "permanent": true },
    { "source": "/agents", "destination": "/faq", "permanent": true }
  ],
  "rewrites": [
    { "source": "/avance-sur-salaire", "destination": "/avance-sur-salaire/index.html" },
    { "source": "/partners", "destination": "/partners/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales/index.html" },
    { "source": "/confidentialite", "destination": "/confidentialite/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    }
  ]
}
